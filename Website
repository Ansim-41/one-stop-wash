                    </p>

                </div>


                <div class="info-box">

                    <h3>🕐 Opening</h3>

                    <p>
                        Opens at 8:00 AM<br>
                        Saturday
                    </p>

                </div>

            </div>

        </div>

    </section>

</div>


<!-- CONTACT -->

<section class="contact" id="contact">

    <h2 class="section-title">
        Get In Touch
    </h2>

    <p>
        One Stop Wash - Calicut<br>
