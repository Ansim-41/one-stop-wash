<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>One Stop Wash - Calicut</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #f5f5f5;
    color: #111;
}

/* NAVBAR */

nav {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 25px;
    background: rgba(255,255,255,.96);
    border-bottom: 1px solid #ddd;
}

nav h1 {
    font-size: 20px;
}

nav a {
    text-decoration: none;
    color: #111;
    margin-left: 18px;
    font-size: 14px;
}

/* HERO */

.hero {
    min-height: 78vh;
    display: flex;
    align-items: center;
    padding: 40px 25px;

    background:
        linear-gradient(rgba(0,0,0,.45),rgba(0,0,0,.6)),
        url("https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1400&q=80");

    background-size: cover;
    background-position: center;
}

.hero-content {
    max-width: 650px;
    color: white;
}

.rating {
    display: inline-block;
    margin-bottom: 20px;
    padding: 8px 12px;
    border-radius: 20px;
    background: rgba(255,255,255,.15);
    backdrop-filter: blur(8px);
}

.hero h2 {
    font-size: clamp(42px, 10vw, 70px);
    line-height: 1;
    margin-bottom: 20px;
}

.hero p {
    font-size: 18px;
    line-height: 1.6;
    color: #eee;
    margin-bottom: 30px;
}

.button {
    display: inline-block;
    padding: 15px 23px;
    background: white;
    color: #111;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
    margin-right: 8px;
    margin-bottom: 10px;
}

/* SECTIONS */

section {
    padding: 70px 25px;
    max-width: 1100px;
    margin: auto;
}

.section-title {
    font-size: 34px;
    margin-bottom: 35px;
}

/* SERVICES */

.services {
    display: grid;
    grid-template-columns:
        repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
}

.card {
    background: white;
    padding: 30px;
    border-radius: 14px;
    border: 1px solid #ddd;
    transition: .25s;
}

.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px #0001;
}

.card h3 {
    margin-bottom: 12px;
    font-size: 20px;
}

.card p {
    color: #666;
    line-height: 1.6;
}

/* BUSINESS INFO */

.info {
    background: #111;
    color: white;
    max-width: none;
}

.info-inner {
    max-width: 1100px;
    margin: auto;
}

.info-grid {
    display: grid;
    grid-template-columns:
        repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
}

.info-box {
    padding: 25px;
    background: #1b1b1b;
    border-radius: 12px;
}

.info-box h3 {
    margin-bottom: 10px;
}

.info-box p {
    color: #aaa;
    line-height: 1.6;
}

/* CONTACT */

.contact {
    text-align: center;
}

.contact p {
    color: #666;
    margin-bottom: 25px;
    line-height: 1.7;
}

/* FOOTER */

footer {
    padding: 25px;
    text-align: center;
    background: #111;
    color: #888;
    font-size: 14px;
}

/* MOBILE */

@media (max-width: 600px) {

    nav a {
        display: none;
    }

    .hero {
        min-height: 72vh;
    }

    section {
        padding: 55px 20px;
    }
}
</style>
</head>

<body>

<!-- NAVIGATION -->

<nav>

    <h1>ONE STOP WASH</h1>

    <div>
        <a href="#services">Services</a>
